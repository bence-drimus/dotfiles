#!/usr/bin/env bash
# Like ghostty-new-window, but launches tmux inside the new window.
# See ghostty-new-window for rationale.

set -euo pipefail

AS=/opt/homebrew/bin/aerospace
BUNDLE_ID=com.mitchellh.ghostty

orig_ws="$("$AS" list-workspaces --focused)"

snapshot_ids() {
  "$AS" list-windows --monitor all --app-bundle-id "$BUNDLE_ID" \
    --format '%{window-id}' 2>/dev/null | sort -u || true
}

pre="$(snapshot_ids)"

if pgrep -xi ghostty > /dev/null 2>&1; then
  osascript \
    -e 'tell application "Ghostty" to activate' \
    -e 'tell application "System Events" to keystroke "n" using command down' \
    -e 'delay 0.25' \
    -e 'tell application "System Events" to keystroke "tmux"' \
    -e 'tell application "System Events" to key code 36' \
    > /dev/null
else
  open -a Ghostty --args -e tmux
fi

new_id=""
for _ in $(seq 1 20); do
  sleep 0.1
  cur="$(snapshot_ids)"
  new_id="$(comm -13 <(printf '%s\n' "$pre") <(printf '%s\n' "$cur") | head -n1)"
  [ -n "$new_id" ] && break
done

[ -z "$new_id" ] && exit 0

"$AS" move-node-to-workspace --window-id "$new_id" "$orig_ws" || true
"$AS" workspace "$orig_ws" || true
"$AS" focus --window-id "$new_id" || true
